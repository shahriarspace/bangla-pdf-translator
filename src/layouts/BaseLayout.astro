---
export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Bangla books translated to English' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | Bangla Library</title>
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <link rel="stylesheet" href={`${base}styles/global.css`} />
</head>
<body>
  <header class="site-header">
    <nav>
      <a href={base} class="logo">Bangla Library</a>
      <div class="nav-links">
        <a href={base}>Home</a>
        <a href={`${base}books/`}>Browse</a>
        <a href={`${base}upload/`}>Upload</a>
      </div>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <p>Bangla PDF to English Book &mdash; Powered by Tesseract OCR &amp; Argos Translate</p>
  </footer>
</body>
</html>
