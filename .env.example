# OpenAI API key (optional - for LLM translation refinement or AI pipeline)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI model to use for translation refinement
OPENAI_MODEL=gpt-4o-mini

# GitHub Models (optional - uses your GitHub PAT for AI refinement / AI pipeline)
# Generate a PAT at https://github.com/settings/tokens with no extra scopes needed
GITHUB_TOKEN=
GITHUB_MODEL=gpt-4o-mini

# Translation settings
# TRANSLATION_MODE: offline (Argos, default), online (Google), hybrid (Argos + Google), ai (full AI literary translation)
TRANSLATION_MODE=offline
FREE_TRANSLATOR=google

# OCR settings
# OCR_ENGINE: tesseract (default, offline) or ai (vision model via API)
OCR_ENGINE=tesseract
# TESSERACT_PATH=/usr/bin/tesseract  # auto-detected in Docker

# Enable LLM refinement after free translation (true/false)
# Not used when TRANSLATION_MODE=ai (AI mode has built-in high-quality translation)
ENABLE_LLM_REFINEMENT=false

# AI Pipeline settings (for OCR_ENGINE=ai and/or TRANSLATION_MODE=ai)
# Ported from PDF-to-Book project — uses OpenAI-compatible API
# AI_PROVIDER: "openai" or "github" (which API endpoint to use)
AI_PROVIDER=github
# AI_OCR_MODEL: Vision-capable model for AI OCR (must support image inputs)
AI_OCR_MODEL=gpt-4o
# AI_TRANSLATE_MODEL: Model for AI literary translation
AI_TRANSLATE_MODEL=gpt-4o
# AI_MAX_RETRIES: Number of retries per page on failure
AI_MAX_RETRIES=3
# AI_RETRY_DELAY: Base delay between retries in seconds
AI_RETRY_DELAY=5.0
# AI_PAGE_DELAY: Delay between pages in seconds (rate limiting)
AI_PAGE_DELAY=2.0

# Server settings
HOST=0.0.0.0
PORT=8000

# Cleanup - automatically remove old job files
JOB_MAX_AGE_HOURS=24
CLEANUP_INTERVAL_MINUTES=30
